rules_version = '2';

// Blackjack Coach usage stats.
// The app writes anonymously (shape-validated creates only); the admin panel
// is the only reader. Nothing else is reachable.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'micorlov@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function shortText(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }

    function recent(t) {
      return t is timestamp
        && t > request.time - duration.value(1, 'd')
        && t < request.time + duration.value(1, 'd');
    }

    function validInstallId(id) {
      return id.matches('^[A-Za-z0-9-]{8,64}$');
    }

    // One doc per anonymous install. The app first creates it with
    // firstSeenAt, then updates the rest on every launch.
    match /installs/{id} {
      allow read, delete: if isAdmin();

      allow create: if validInstallId(id)
        && request.resource.data.keys().hasOnly(['firstSeenAt'])
        && recent(request.resource.data.firstSeenAt);

      allow update: if validInstallId(id)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['version', 'platform', 'lang', 'country', 'lastOpenAt'])
        && shortText(request.resource.data.version, 64)
        && shortText(request.resource.data.platform, 64)
        && shortText(request.resource.data.lang, 64)
        && shortText(request.resource.data.country, 64)
        && recent(request.resource.data.lastOpenAt);
    }

    match /sessions/{id} {
      allow read, delete: if isAdmin();

      allow create: if request.resource.data.keys()
             .hasOnly(['installId', 'drill', 'accuracy', 'questions', 'at'])
        && validInstallId(request.resource.data.installId)
        && shortText(request.resource.data.drill, 64)
        && request.resource.data.accuracy is int
        && request.resource.data.accuracy >= 0
        && request.resource.data.accuracy <= 100
        && request.resource.data.questions is int
        && request.resource.data.questions >= 1
        && request.resource.data.questions <= 1000
        && recent(request.resource.data.at);
    }

    match /errors/{id} {
      allow read, delete: if isAdmin();

      allow create: if request.resource.data.keys().hasOnly(['message', 'version', 'at'])
        && shortText(request.resource.data.message, 300)
        && shortText(request.resource.data.version, 64)
        && recent(request.resource.data.at);
    }

    // Daily rollup written by the GitHub Actions job (Admin SDK bypasses rules).
    match /system/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
